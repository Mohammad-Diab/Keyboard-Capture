<Window x:Class="MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Key Finder" Height="350" Width="525" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp_1">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFBDD9E4" Offset="0"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <ListBox Name="nn" Margin="10,45,10,10" Background="{x:Null}"/>
        <Button Content="Clear List" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="173" Height="30" Click="Button_Click" FontSize="16" Background="{x:Null}"/>
        <Button Content="about" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="173" Height="30" Click="Button1_Click" FontSize="16" Background="{x:Null}"/>
    </Grid>
</Window>
